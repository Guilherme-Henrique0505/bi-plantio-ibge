table Medidas
	lineageTag: 38b92eb9-1dab-4e81-81af-8f0d5f7aba3b

	measure 'Total Área' = SUM('USO DO SOLO'[Área de uso do solo])
		formatString: #,0.00
		lineageTag: aa5fb7cb-12ea-4a54-9db1-4168de0142fc

	measure 'Total Soja' =
			CALCULATE(
			SUM('USO DO SOLO'[Área de uso do solo]),
			FILTER('USO DO SOLO', 'USO DO SOLO'[UsoSolo] = "Soja"
			))
		lineageTag: 31b3b283-a56c-49a1-80a7-2b43b4e45c30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Silvicultura' =
			CALCULATE(
			SUM('USO DO SOLO'[Área de uso do solo]),
			FILTER('USO DO SOLO', 'USO DO SOLO'[UsoSolo] = "Silvicultura"
			))
		lineageTag: 04cf04c6-24f2-4230-9302-d8e19eb536a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Pastagem' =
			CALCULATE(
			SUM('USO DO SOLO'[Área de uso do solo]),
			FILTER('USO DO SOLO', 'USO DO SOLO'[UsoSolo] = "Pastagem"
			))
		lineageTag: 9514f3be-b1c7-403b-9e71-a1f0994118c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Agricultável' = 'Medidas'[Total Pastagem] + 'Medidas'[Total Soja] + 'Medidas'[Total Silvicultura]
		formatString: #,0.00
		lineageTag: 17ddf561-13b5-45dc-a636-6420fd78c483

	measure Aproveitamento = 'Medidas'[Total Agricultável] / 'Medidas'[Total Área]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0200ee2d-af58-4188-82de-35473d060d00

	measure 'crd_Total Propriedades' = ```
			
			VAR titulo = "Total de Propriedades" 
			VAR cor_primaria = "#CED842"
			VAR cor_secundaria = "#5D6E07"
			VAR cor_neutra = "#F0F0F1"
			VAR icone = "<svg xmlns='http://www.w3.org/2000/svg' class='icon' viewBox='0 0 16 16'>
			  <path d='M8.277.084a.5.5 0 0 0-.554 0l-7.5 5A.5.5 0 0 0 .5 6h1.875v7H1.5a.5.5 0 0 0 0 1h13a.5.5 0 1 0 0-1h-.875V6H15.5a.5.5 0 0 0 .277-.916zM12.375 6v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zm-2.5 0v7h-1.25V6zM8 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2M.5 15a.5.5 0 0 0 0 1h15a.5.5 0 1 0 0-1z'/>
			</svg>"
			VAR valor = FORMAT([Total Propriedades], "#,#", "pt-br")
			RETURN
			"<html lang='pt-br'>
			<head>
			  <meta charset='UTF-8'>
			  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
			  <style>
			    .card {
			      width: 270px;
			      height: 82px;
			      background-color: " & cor_neutra & ";
			      border-radius: 10px;
			      display: flex;
			      flex-direction: column;
			      align-items: center;
			      justify-content: center;
			      position: relative;
			      transition: all 0.3s ease-in-out;
			      cursor: pointer;
			    }
			    .title {
			      font-size: 12px;
			      font-weight: bold;
			      color: " & cor_secundaria & ";
			      position: absolute;
			      top: 5px;
			      transition: color 0.3s ease;
			    }
			    .icon {
			      margin-top:7%;
			      margin-bottom: 2%;
			      width: 20px;
			      fill: " & cor_secundaria & ";
			      height: 20px;
			      transition: fill 0.3s ease;
			    }
			    .value {
			      font-size: 20px;
			      color: " & cor_secundaria & ";
			      font-weight: bold;
			      transition: color 0.3s ease;
			    }
			    
			    .card:hover {
			      transform: scale(1.05);
			      background-color: " & cor_primaria & ";
			    }
			    .card:hover .value {
			      color: " & cor_neutra & ";
			    }
			    .card:hover .title {
			      color: " & cor_neutra & ";
			    }
			    .card:hover .icon path {
			      fill: " & cor_neutra & ";
			    }
			  </style>
			</head>
			<body>
			  <div class='card'>
			    <div class='title'>
			      " & titulo & "
			    </div>
			    <div class='icon'>
			      " & icone & "
			    </div>
			    <div class='value'>
			      " & valor & "
			    </div>
			  </div>
			</body>
			</html>"
			
			```
		lineageTag: 96efdd81-f318-4fed-a569-5e3cb7d0034f

	measure 'Total Propriedades' = DISTINCTCOUNT('USO DO SOLO'[NOMEPROPRI])
		formatString: 0
		lineageTag: 902a2c22-a4bf-4b56-88d9-83d6219d86b8

